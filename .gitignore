# =============================================================================
# alaska-fuel-multimodal-network — merged ignore regime
# Every block states WHY it is ignored. Reconciles the friction repo's
# blanket-geodata+negations regime with the network repo's data/** regime.
# =============================================================================

# --- Python bytecode / packaging: machine-generated, never committed ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# --- Virtual environments: machine-local, recreate with `uv sync` ---
.venv/
venv/
env/
.env/

# --- Notebooks: checkpoints + executed copies are regenerable (tools/build_notebooks.py) ---
.ipynb_checkpoints/
*.executed.ipynb

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
__MACOSX/

# --- R session junk (left behind by r_oracle runs) ---
.RData
.Rhistory
.Rproj.user/

# --- Stray skill copies (repo-B on-disk junk; canonical skills live in .claude/skills/) ---
example_skills/

# --- Blanket geodata excludes: rasters/vectors are regenerated or fetched, not committed ---
# Rasters (friction stack, GEE exports — up to ~12 GB regenerable)
*.tif
*.tiff
*.img
*.vrt
*.nc
*.hdf
*.hdf5
# Shapefile binary components (data ships zipped; extracted copies are regenerable)
*.shp
*.shp.xml
*.shx
*.dbf
*.sbn
*.sbx
*.cpg
*.prj
# Container geospatial formats (pipeline intermediates)
*.gpkg
*.gdb/
*.qgz
# Archives: blanket-ignored; the specific committed data zips are opted back in below
*.zip

# --- inputs/: the single home for every dataset (blanket-ignored, committed files opted in) ---
# inputs/gee_exports/    — 4.7 GB AK_Stack_150m.zip: exceeds GitHub's 100 MB limit; regenerate
#                          via src/friction_surface/friction_preprocessing GEE script
# inputs/friction_rasters/ — ~7 GB slope/lulc/permafrost + sea_ice/ + river_ice/: regenerable
#                          from gee_exports + the arcpy river-ice pipeline
inputs/*
!inputs/README.md
!inputs/MANIFEST.md
# Small committed data zips (each < 50 MB, plain git blobs) so a fresh clone can run acts (c)-(d)
!inputs/bulk_fuel_data.zip
!inputs/data_for_network_build.zip
!inputs/region_and_census_data.zip
# network_raw.zip is deliberately NOT negated: it stays LOCAL-ONLY (license-gated,
# see inputs/README.md) and was purged from git history on 2026-08-08.
# Small tracked air CSVs (diffable plain text)
!inputs/air/
inputs/air/*
!inputs/air/airports_ak_dotpf.csv
!inputs/air/flight_paths_combined.csv
# flight_paths.xlsx moves inside network_raw.zip once that zip is assembled (license-gated);
# until then the tracked copy lives here
!inputs/air/flight_paths.xlsx

# --- data/: workflow-02 working tree (interim/processed/basemap/boundary) ---
# regenerated by workflows/02_network_build scripts 00-03 from inputs/network_raw.zip
data/

# --- outputs/: regenerables ignored with reasons; committed deliverables live in
#     outputs/{figures,tables,analysis,final_network_plots} (not matched by rules here) ---
outputs/01_friction_build/
# ^ ~288 MB friction stack + waterway mask — regenerated by workflow 01
outputs/02_network_build/
# ^ gpkg stages + reports + qgz — regenerated by workflow 02
outputs/.checkpoint
*.duckdb
# ^ outputs/fuel_network.duckdb ~30 MB — regenerated by workflows 03-04

# --- final_network/: frozen handoff zips ARE committed (edge_id contract);
#     extracted dirs are regenerated by workflows/03_multimodal_join/01_extract ---
final_network/*/
!final_network/network_joined_edges.zip
!final_network/network_joined_nodes.zip

# --- research/ sandboxes: track scripts + FINDINGS.md, drop generated outputs ---
research/**/out/
research/**/*.html
research/**/*_files/

# --- Logs (timestamped, written by pipeline_utils.setup_logging) ---
*.log

# --- Guards: internal-only staging that must never land in the public repo ---
DOE_MAS-public-internal/
*Handoff*.pdf
PLAN_network_friction_integration.md
Fuel Cost Resources.pdf
cost_derivation_resources/
