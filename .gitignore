# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
*.egg
build/
dist/

# Virtual environments
venv/
env/
.venv/
.env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# OS files
Thumbs.db

# Outputs (not code)
outputs/.checkpoint

# Large data files (should be downloaded/regenerated, not committed)
rasters/
vectors/

# Geospatial data blobs — code regenerates or downloads these (~28 GB)
# Rasters
*.tif
*.tiff
*.img
*.vrt
*.nc
*.hdf
*.hdf5
# Shapefiles (binary components; keep code, not data)
*.shp
*.shx
*.dbf
*.sbn
*.sbx
*.cpg
*.prj
# Packaged / container geospatial formats
*.gpkg
*.gdb/
# Archives (downloaded source data)
*.zip

# Bulk data directories
# NOTE: `inputs/*` (not `inputs/`) so git still descends into the folder and the
# three small input zips can be re-included below. `inputs/gee_exports/` (the
# 4.7 GB AK_Stack_150m.zip) stays ignored via this rule — regenerate it in GEE.
inputs/*
friction_surface/friction_inputs/
friction_surface/friction_outputs/
friction_surface/friction_preprocessing/data/
final_network/*/

# DuckDB database (regenerated each run)
*.duckdb

# Log files
*.log

# ─────────────────────────────────────────────────────────────────────────────
# Public-repo additions (see EXTERNAL_DATA.md)
# ─────────────────────────────────────────────────────────────────────────────
# The rules above keep inputs/* and *.zip out of git. The 4.7 GB
# inputs/gee_exports/AK_Stack_150m.zip is present ON DISK but is NOT committed —
# it exceeds GitHub's 100 MB/file limit. It is fully regenerable from the GEE
# script documented in README.md ("Preprocessing friction inputs") and
# EXTERNAL_DATA.md, so it is intentionally left ignored (no external host needed).

# Small vector/tabular input zips (~40 MB total, all < 100 MB) — committed so a
# fresh clone can run network ingest without re-running GEE. Re-included past the
# blanket `inputs/*` and `*.zip` rules above.
!inputs/data_for_network_build.zip
!inputs/region_and_census_data.zip
!inputs/bulk_fuel_data.zip
!inputs/README.md

# Delivered network zips — small enough to commit (9.5 MB + 1.2 MB) and the
# ingest step (load_final_network.py) reads them. Opt them back in past the
# blanket *.zip rule above so a fresh clone is runnable.
!final_network/network_joined_edges.zip
!final_network/network_joined_nodes.zip

# Guard: never commit internal-only staging if it is ever placed inside the repo
DOE_MAS-public-internal/
*Handoff*.pdf
PLAN_network_friction_integration.md
Fuel Cost Resources.pdf
cost_derivation_resources/
