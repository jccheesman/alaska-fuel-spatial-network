+def _cell_latitude(
+    rows: np.ndarray,
+    cols: np.ndarray,
+    transform,
+    crs,
+) -> np.ndarray:
+    """WGS84 latitude of the given grid cells' centres.
+
+    Computed for listed cells only. A full-grid latitude array would be
+    28,001 x 16,567 float32 = 1.85 GB; the callers need a few hundred
+    thousand cells at most.
+    """
+    import pyproj  # local import: only the band fallback needs it
+
+    x = transform.c + (cols + 0.5) * transform.a
+    y = transform.f + (rows + 0.5) * transform.e
+    to_wgs = pyproj.Transformer.from_crs(crs, "EPSG:4326", always_xy=True)
+    return to_wgs.transform(x, y)[1]
+
+
+def fill_by_latitude_band(
+    ice: np.ndarray,
+    coverage: np.ndarray,
+    target_mask: np.ndarray,
+    transform,
+    crs,
+    half_deg: float = RIVER_ICE_BAND_HALF_DEG,
+    bin_deg: float = 0.05,
+) -> np.ndarray:
+    """Give unfillable river cells the median p_ice of their latitude band.
+
+    Third and last tier of the river-ice gate, for cells the IDW does not
+    cover AND that have no covered cell within RIVER_ICE_FILL_MAX_KM. Those
+    are regionally clustered — Egegik, Naknek and Ugashik have no coverage at
+    all — so leaving them at p_ice = 0 would open the whole of Bristol Bay in
+    midwinter. Borrowing from the nearest covered cell is worse still: it
+    reaches 90-227 km into another watershed, which is what the cap exists to
+    forbid.
+
+    The band median is the same Brown product read as a regional climatology.
+    It preserves the north-south freeze gradient that a blanket seasonal
+    window would flatten, while the reach is statistical and bounded instead
+    of spatial and unbounded.
+
+    Targets are binned to `bin_deg` before the median so the cost is one
+    median per occupied bin (a few hundred) rather than one per cell.
+    Cells whose band contains no covered cell keep their existing value.
+    """
+    if not target_mask.any() or not coverage.any():
+        return ice
+
+    src_rows, src_cols = np.nonzero(coverage)
+    src_lat = _cell_latitude(src_rows, src_cols, transform, crs)
+    src_val = ice[src_rows, src_cols]
+    order = np.argsort(src_lat, kind="stable")
+    src_lat, src_val = src_lat[order], src_val[order]
+
+    tgt_rows, tgt_cols = np.nonzero(target_mask)
+    tgt_lat = _cell_latitude(tgt_rows, tgt_cols, transform, crs)
+
+    out = ice.copy()
+    keys = np.round(tgt_lat / bin_deg).astype(np.int64)
+    for key in np.unique(keys):
+        centre = key * bin_deg
+        lo = np.searchsorted(src_lat, centre - half_deg, side="left")
+        hi = np.searchsorted(src_lat, centre + half_deg, side="right")
+        if hi <= lo:
+            logger.warning(
+                "latitude band %.2f+/-%.2f deg has no IDW-covered cell; "
+                "%d river cell(s) keep p_ice=0 and will read as never frozen",
+                centre, half_deg, int((keys == key).sum()),
+            )
+            continue
+        sel = keys == key
+        out[tgt_rows[sel], tgt_cols[sel]] = np.median(src_val[lo:hi])
+    return out
+
